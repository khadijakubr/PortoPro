# ============================================================================
# Contoh Environment Variables — salin menjadi `.env` untuk jalan lokal,
# dan isi nilai yang sama di Render Dashboard > Service > Environment.
# CATATAN: file `.env` asli JANGAN di-commit (sudah ada di .gitignore).
# ============================================================================

# --- Database (isi dari TiDB Cloud Serverless / PlanetScale / Clever Cloud) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=PortoPro
# true untuk DB cloud (wajib SSL), false untuk MySQL lokal tanpa SSL
DB_SSL=false
# Opsional: path file CA bila provider memberikannya. Kosongkan bila tidak ada.
DB_SSL_CA=

# --- Cloudinary (isi dari dashboard.cloudinary.com, gratis) ---
# Kalau ketiga variabel di bawah KOSONG, aplikasi otomatis fallback ke
# penyimpanan lokal media/image/uploads/ (mode dev lokal).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Nama folder di Cloudinary agar rapi, mis. portopro/uploads
CLOUDINARY_FOLDER=portopro/uploads
# Upload preset bertipe "unsigned" — hanya perlu kalau memakai unsigned upload.
# Kita memakai SIGNED upload via server (lebih aman), jadi boleh kosong.
CLOUDINARY_UPLOAD_PRESET=

# --- Aplikasi ---
# true di laptop (error tampil), false di Render (error masuk Logs saja)
APP_DEBUG=true
# URL publik aplikasimu, mis. https://portopro.onrender.com (untuk canonical/redirect)
APP_URL=http://localhost:8000
